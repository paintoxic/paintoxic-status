---
import type { Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (location.pathname === "/" && localStorage.getItem("lang") === "en") location.replace("/en/");
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/52616558?v=4" />
    <link rel="canonical" href={new URL(locale === "es" ? "/" : "/en/", Astro.site)} />
    <link rel="alternate" hreflang="es" href="https://paintoxic.io/" />
    <link rel="alternate" hreflang="en" href="https://paintoxic.io/en/" />
    <link rel="alternate" hreflang="x-default" href="https://paintoxic.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Instrument+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #1a1b26;
    --surface: #24283b;
    --surface-2: #1f2335;
    --line: #292e42;
    --text: #c0caf5;
    --text-2: #a9b1d6;
    --muted: #565f89;
    --accent: #7aa2f7;
    --green: #9ece6a;
    --yellow: #e0af68;
    --red: #f7768e;
    --purple: #bb9af7;
    --sans: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    --mono: "Fira Code", ui-monospace, SFMono-Regular, Menlo, monospace;
    color-scheme: dark;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
    color: var(--text);
    font: 400 1rem/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  body {
    margin: 0;
  }
  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .mono {
    font-family: var(--mono);
    font-feature-settings: "calt" 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
