---
import type { Locale } from "../i18n/index.ts";
import { personJsonLd, SITE } from "../lib/seo.ts";
import "@fontsource/instrument-sans/latin-400.css";
import "@fontsource/instrument-sans/latin-500.css";
import "@fontsource/instrument-sans/latin-600.css";
import "@fontsource/instrument-sans/latin-700.css";
import "@fontsource/fira-code/latin-400.css";
import "@fontsource/fira-code/latin-500.css";
import "@fontsource/fira-code/latin-600.css";
import sans400 from "@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url";
import sans700 from "@fontsource/instrument-sans/files/instrument-sans-latin-700-normal.woff2?url";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const url = `${SITE}${locale === "es" ? "/" : "/en/"}`;
const ogLocale = locale === "es" ? "es_CO" : "en_US";
const ogAlt = locale === "es" ? "en_US" : "es_CO";
const jsonLd = JSON.stringify(personJsonLd(locale));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (location.pathname === "/" && localStorage.getItem("lang") === "en") location.replace("/en/");
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="paintoxic.io" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlt} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="paintoxic.io / status — All systems operational" />
    <meta property="profile:username" content="paintoxic" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href="https://paintoxic.io/" />
    <link rel="alternate" hreflang="en" href="https://paintoxic.io/en/" />
    <link rel="alternate" hreflang="x-default" href="https://paintoxic.io/" />
    <link rel="alternate" type="application/json" title="Status API" href="/api/status.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans700} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #1a1b26;
    --surface: #24283b;
    --surface-2: #1f2335;
    --line: #292e42;
    --text: #c0caf5;
    --text-2: #a9b1d6;
    --muted: #8089b3;
    --accent: #7aa2f7;
    --green: #9ece6a;
    --yellow: #e0af68;
    --red: #f7768e;
    --purple: #bb9af7;
    --sans: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    --mono: "Fira Code", ui-monospace, SFMono-Regular, Menlo, monospace;
    color-scheme: dark;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
    color: var(--text);
    font: 400 1rem/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  body {
    margin: 0;
  }
  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .mono {
    font-family: var(--mono);
    font-feature-settings: "calt" 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
