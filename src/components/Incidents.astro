---
import { t, type Locale } from "../i18n/index.ts";
import { incidents } from "../data/presentation.ts";
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const fmtMonth = (ym: string) =>
  new Intl.DateTimeFormat(locale === "es" ? "es-CO" : "en-US", { month: "short", year: "numeric", timeZone: "UTC" }).format(
    new Date(`${ym}-01T00:00:00Z`),
  );
---
<section aria-labelledby="inc-h">
  <h2 id="inc-h">{d.incidents.title}</h2>
  <p class="sub">{d.incidents.subtitle}</p>
  <ol>
    {incidents.map((i) => (
      <li class:list={[i.kind, { todo: i.todo }]}>
        <span class="when mono">{i.date ? fmtMonth(i.date) : d.incidents.unknownDate}</span>
        <span class="mark" aria-hidden="true"></span>
        <div>
          <span class="kind mono">{d.incidents.kinds[i.kind]}</span>
          <p>{i[locale]}{i.todo && <span class="flag mono">{d.incidents.todo}</span>}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  section { margin-top: 2.5rem; }
  h2 { margin: 0; font-size: 1.15rem; }
  .sub { margin: 0.15rem 0 1rem; color: var(--muted); font-size: 0.9rem; }
  ol { list-style: none; margin: 0; padding: 0; position: relative; }
  li { display: grid; grid-template-columns: 6.5rem 1rem 1fr; gap: 0 0.9rem; position: relative; padding-bottom: 1.2rem; }
  li::before { content: ""; position: absolute; left: calc(6.5rem + 0.9rem + 0.5rem - 1px); top: 1.1rem; bottom: 0; width: 2px; background: var(--line); }
  li:last-child::before { display: none; }
  .when { color: var(--muted); font-size: 0.8rem; text-align: right; padding-top: 0.15rem; }
  .mark { width: 1rem; height: 1rem; margin-top: 0.15rem; border-radius: 50%; border: 3px solid var(--bg); box-shadow: 0 0 0 2px currentColor; background: currentColor; position: relative; z-index: 1; }
  .resolved { color: var(--green); }
  .maintenance { color: var(--accent); }
  .degraded { color: var(--yellow); }
  .kind { font-size: 0.75rem; }
  p { margin: 0.1rem 0 0; color: var(--text); }
  .todo p { color: var(--muted); font-style: italic; }
  .todo .when { color: var(--yellow); }
  .flag { white-space: nowrap; margin-left: 0.6rem; font-style: normal; font-size: 0.72rem; color: var(--yellow); border: 1px dashed var(--yellow); border-radius: 4px; padding: 0 0.35rem; }
  @media (max-width: 520px) {
    li { grid-template-columns: 1rem 1fr; }
    li::before { left: calc(0.5rem - 1px); }
    .when { grid-column: 2; grid-row: 1; text-align: left; }
    .mark { grid-column: 1; grid-row: 1 / span 2; }
    li > div { grid-column: 2; grid-row: 2; }
  }
</style>
